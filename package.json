{
  "name": "react-telemetry-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakshamgupta912/react-telemetry-kit.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./appinsights": {
      "types": "./dist/appinsights.d.ts",
      "import": "./dist/appinsights.js"
    },
    "./appinsights/initialize": {
      "types": "./dist/appinsights-initialize.d.ts",
      "import": "./dist/appinsights-initialize.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "magic-string": "^0.30.17",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@microsoft/applicationinsights-web": "^3.3.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@microsoft/applicationinsights-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@jridgewell/trace-mapping": "^0.3.29",
    "@microsoft/applicationinsights-web": "^3.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
